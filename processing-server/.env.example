PORT=3100
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Supabase — get from project settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # service_role key (NOT anon key)
SUPABASE_ANON_KEY=eyJ...          # anon / public key

# Anthropic Claude — for AI summaries & questions (optional, degrades gracefully)
CLAUDE_API_KEY=sk-ant-...

# Optional: secure the server endpoints with an API key
# If set, all requests must include header: X-Api-Key: <this value>
PROCESSING_SERVER_API_KEY=

# Frontend origins allowed for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com
